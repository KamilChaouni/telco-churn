# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments and their backups (recreate with `uv sync --locked`)
.venv
.venv*/

# Credentials / local settings
.env
*.pem
*.key

# Data: never versioned. Raw snapshot is downloaded and verified by hash
# (see references/data_source.md). Folder layout kept with .gitkeep.
data/**
!data/**/
!data/**/.gitkeep

# Generated outputs: regenerated by commands in README.md
reports/*
!reports/.gitkeep
models/*
!models/.gitkeep

# Deliberately tracked: small, non-sensitive evidence in evidence/tp01/
