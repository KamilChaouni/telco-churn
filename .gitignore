# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments and their backups (recreate with `uv sync --locked`)
.venv
.venv*/

# Credentials / local settings
.env
*.pem
*.key

# Data: never versioned. Raw snapshot is downloaded and verified by hash
# (see references/data_source.md). Folder layout kept with .gitkeep.
data/**
!data/**/
!data/**/.gitkeep

# Generated outputs: regenerated by commands in README.md
reports/*
!reports/.gitkeep
# TP02 submission: comparison/selection reports and the selected fitted artifact
# are deliberately tracked (small, non-sensitive, needed for assessment).
!reports/tp02/
reports/tp02/example_predictions.csv
models/*
!models/.gitkeep
!models/churn_pipeline.joblib
!models/churn_pipeline.metadata.json
!models/split_assignment.csv
!models/reference_batch.csv

# Deliberately tracked: small, non-sensitive evidence in evidence/tp01/
